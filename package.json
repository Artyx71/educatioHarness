{
  "name": "educatio-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run runtime:build && vitest run",
    "tauri": "tauri",
    "runtime:build": "tsc -p agent-runtime/tsconfig.json",
    "runtime:dev": "npm run runtime:build",
    "desktop:build": "npm run runtime:bundle && npm run build && tauri build",
    "desktop:build:rpm": "npm run runtime:bundle && npm run build && tauri build --bundles rpm",
    "runtime:bundle": "npm run runtime:build && node scripts/prepare-sidecar.mjs"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.167.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "@tauri-apps/api": "^2.9.0",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "katex": "^0.16.25",
    "lucide-react": "^0.468.0",
    "openai": "^7.55.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/dagre": "^0.7.53",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
